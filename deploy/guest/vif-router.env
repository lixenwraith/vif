# The router's settings for this deployment. update-vif-router.sh installs
# this file as /etc/vif-router/router.env; edit it here and run that script,
# never the installed copy. VIF_ROUTER_IMAGE is absent on purpose: it names the
# session image the node last built, so update-vif-image.sh writes it and
# update-vif-router.sh carries it over. Nothing here is a secret.
VIF_ROUTER_LISTEN=:9080
# The native front door, one port for every session, which join_target names and
# the one port the host forwards, with the player's address intact.
VIF_ROUTER_ROUTE_LISTEN=:7777
# The front door behind the site's edge: the edge ends TLS for 7777 and writes a
# PROXY header before each dial, so the router budgets the player's address and
# closes a dial without one; the links it hands out then read vifs://. Set both to
# true when the edge's stream block fronts 7777; empty while 7777 reaches the node
# raw.
VIF_ROUTER_ROUTE_PROXY_PROTOCOL=
VIF_ROUTER_ROUTE_SECURE=
# The seed admission tickets are signed with: update-vif-router.sh makes it once
# with `vif-router keygen`, root:vif-router 0640, never in this repository. Each
# session's doors take the router's tickets and no bare key; empty mints none and
# the sessions run open.
VIF_ROUTER_TICKET_KEY=/etc/vif-router/ticket.key
# The front door ending TLS itself with a certificate made at each start, for a
# deployment with no edge to end it: the sessions API then carries the door's
# fingerprint, which a dial pins. Empty here: the edge ends TLS for 7777.
VIF_ROUTER_ROUTE_SELFSIGN=
# The identity service on this node (lixenwraith/identity): the listener
# /vif/api/auth/ is forwarded to, and the one asked which account a sign-in names.
# Both empty publishes no accounts, and every ticket names the player's address.
VIF_ROUTER_IDENTITY_URL=http://127.0.0.1:9082
VIF_ROUTER_INTROSPECT_URL=http://127.0.0.1:9083/introspect
VIF_ROUTER_JOIN_HOST=lixen.com
VIF_ROUTER_LOG_STREAM_URL=http://127.0.0.1:8081/stream
# What a request may select. Trace stays out of reach: the fleet's log rate and
# tmpfs are shared, and an anonymous request must not raise either.
VIF_ROUTER_PLAYERS_MAX=4
# A session's own bots, closed until doc/todo.md "Open fleet sessions to bots" holds.
VIF_ROUTER_BOTS_MAX=0
VIF_ROUTER_LOG_LEVEL_MIN=debug
VIF_ROUTER_SCENARIO=main
VIF_ROUTER_WAD=/var/db/vif/wad
# The browser route: the origin publishes it and is the only one /vif/ws/<session>
# answers. The router speaks WebSocket on it and splices each socket to its pod.
VIF_ROUTER_WEB_ORIGIN=https://lixen.com
# Connections per session through the front door and the browser route together,
# above the roster so a dropped player's slot does not refuse its own reconnect.
VIF_ROUTER_ROUTE_MAX=6
# Doors runs publish through the router (-relay vif://<site>:7777), reached by name
# at the front door as a pod is; 0 publishes none.
VIF_ROUTER_TUNNELS=16
# Doors one address may publish at once; 0 leaves it to the ceiling above.
VIF_ROUTER_DOORS_PER_ADDRESS=4
# The header the site's edge overwrites with the player's address on the API and
# browser locations. Empty, those routes charge no per-address budget.
VIF_ROUTER_CLIENT_ADDRESS_HEADER=X-Real-IP
# Per player address (an IPv6 one's /64): joins a minute over both routes, loose
# for a player whose link drops and comes back, and sessions created per
# -first-join window, one, so an address holds one unclaimed session at a time.
VIF_ROUTER_CLIENT_JOINS=6
VIF_ROUTER_CLIENT_CREATES=1
# A signed-in account's own create budget per -first-join window, in place of its
# address's, so a player behind a shared address is not held to its neighbours';
# its joins count under the account at the same rate as an address's. 0 budgets
# every create by address.
VIF_ROUTER_ACCOUNT_CREATES=4
