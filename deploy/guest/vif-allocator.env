# The allocator's settings for this deployment. update-vif-allocator.sh installs
# this file as /etc/vif-allocator/allocator.env; edit it here and run that script,
# never the installed copy. VIF_ALLOCATOR_IMAGE is absent on purpose: it names the
# session image the node last built, so update-vif-image.sh writes it and
# update-vif-allocator.sh carries it over. Nothing here is a secret.
VIF_ALLOCATOR_LISTEN=:9080
# The native front door, one port for every session, which join_target names. The
# host forwards it with the player's address intact, as it does the NodePort range.
VIF_ALLOCATOR_ROUTE_LISTEN=:7777
VIF_ALLOCATOR_JOIN_HOST=lixen.com
VIF_ALLOCATOR_LOG_STREAM_URL=http://127.0.0.1:8081/stream
# What a request may select. Trace stays out of reach: the fleet's log rate and
# tmpfs are shared, and an anonymous request must not raise either.
VIF_ALLOCATOR_PLAYERS_MAX=4
VIF_ALLOCATOR_LOG_LEVEL_MIN=debug
VIF_ALLOCATOR_SCENARIO=main
VIF_ALLOCATOR_WAD=/var/db/vif/wad
# The browser route, both or neither. The origin is the only one /vif/ws/<session>
# answers; the image is what update-vif-ws-bridge.sh imports from the node's websocat.
VIF_ALLOCATOR_WEB_ORIGIN=https://lixen.com
VIF_ALLOCATOR_WS_BRIDGE_IMAGE=docker.io/library/vif-ws-bridge:local
# Connections per session through the front door and the browser route together,
# above the roster so a dropped player's slot does not refuse its own reconnect.
VIF_ALLOCATOR_ROUTE_MAX=6
