[Unit]
Description=vif Kubernetes session allocator
After=network-online.target k3s.service vif-allocator-token.service logwisp.service
Requires=k3s.service
Wants=network-online.target vif-allocator-token.service logwisp.service
ConditionPathExists=/etc/vif-allocator/allocator.env
ConditionPathExists=/etc/vif-allocator/server-ca.crt

[Service]
# The allocator answers READY=1 once its listener is bound, so `systemctl start`
# returns when it answers. Every caller that restarts it and then probes it — the
# updaters, an operator at a prompt — was otherwise racing the bind.
Type=notify
TimeoutStartSec=30s
User=vif-allocator
Group=vif-allocator
EnvironmentFile=/etc/vif-allocator/allocator.env
ExecStart=/usr/local/bin/vif-allocator \
    -listen ${VIF_ALLOCATOR_LISTEN} \
    -route-listen ${VIF_ALLOCATOR_ROUTE_LISTEN} \
    -image ${VIF_ALLOCATOR_IMAGE} \
    -join-host ${VIF_ALLOCATOR_JOIN_HOST} \
    -players-max ${VIF_ALLOCATOR_PLAYERS_MAX} \
    -log-level-min ${VIF_ALLOCATOR_LOG_LEVEL_MIN} \
    -scenario ${VIF_ALLOCATOR_SCENARIO} \
    -wad ${VIF_ALLOCATOR_WAD} \
    -web-origin ${VIF_ALLOCATOR_WEB_ORIGIN} \
    -route-max ${VIF_ALLOCATOR_ROUTE_MAX} \
    -client-address-header ${VIF_ALLOCATOR_CLIENT_ADDRESS_HEADER} \
    -client-joins ${VIF_ALLOCATOR_CLIENT_JOINS} \
    -client-creates ${VIF_ALLOCATOR_CLIENT_CREATES} \
    -log-stream-url ${VIF_ALLOCATOR_LOG_STREAM_URL}
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
