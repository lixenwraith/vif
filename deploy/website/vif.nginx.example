# Reference edge for the allocator API. Copy the two parts into their own
# contexts; this file is not includable as a unit. Replace <node-address> with
# the K3s node's address on the operator network, which must already admit that
# source on 9080. Nothing here terminates or inspects a game connection.

# --- http context ---
upstream vif_allocator {
    server <node-address>:9080;
    keepalive 8;
}

# WebSocket Upgrade is hop-by-hop, so preserve it explicitly. This map belongs
# in the http context beside the upstream, not inside a server or location.
map $http_upgrade $vif_connection_upgrade {
    default upgrade;
    ''      close;
}

# What the session route is bounded by at the edge; see the location below. The site
# takes connections over PROXY protocol, so the player is $proxy_protocol_addr.
limit_conn_zone $proxy_protocol_addr zone=vif_ws_conn:10m;
limit_req_zone  $proxy_protocol_addr zone=vif_ws_req:10m rate=12r/m;

# The Content-Security-Policy on the page that *opens* the socket — the one
# loading the WASM build, not the one listing sessions — must permit it. CSP 3
# says 'self' covers wss:// on the page's own host; naming it as well costs
# nothing and needs no browser to have implemented that clause. A page carrying
# its own <meta> policy intersects with the header, so both want the value:
#
#   connect-src 'self' wss://<site-host>;

# --- server context, inside the site's TLS server block ---

# Create and list. Finite requests, so ordinary proxy timeouts apply.
location = /vif/api/sessions {
    proxy_pass http://vif_allocator;
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
}

# One long-lived SSE response. Buffering, caching or a finite read timeout here
# turns a live stream into a stalled or truncated one.
location = /vif/api/logs {
    proxy_pass http://vif_allocator;
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    proxy_buffering off;
    proxy_cache off;
    gzip off;
    chunked_transfer_encoding on;

    proxy_connect_timeout 5s;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

# The browser session route. Nginx terminates TLS and forwards the Upgrade; it
# does not translate WebSocket frames. The allocator validates the session, the
# Origin and the fleet's ceilings, then proxies the upgraded connection to the
# bridge sidecar in that session's pod, which is what speaks WebSocket.
#
# Origin is forwarded unchanged, because it is the whole of same-origin here and
# the allocator compares it against its -web-origin. Do not set it.
#
# A proxy_set_header in a location replaces every one inherited from the server,
# so the four below are all this route sends. That is correct here: the allocator
# reads only Origin, which travels as an ordinary request header. `http2 on` is
# also fine — nginx offers no RFC 8441, so a browser opens its socket on a
# separate HTTP/1.1 connection; an empty Upgrade is where to look if it does not.
location ~ "^/vif/ws/[0-9a-f]{16}$" {
    proxy_pass http://vif_allocator;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $vif_connection_upgrade;

    proxy_buffering off;
    proxy_cache off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    # The per-player bound the game cannot apply here: every browser reaches the
    # pod from one loopback address, so its admission limiter sees one player.
    # Four is a household behind one address — raise it behind carrier NAT. This
    # and the allocator's -route-max are the whole of the bound, so both are numbers
    # somebody should choose rather than inherit.
    limit_conn vif_ws_conn 4;
    limit_req zone=vif_ws_req burst=4 nodelay;
}

# A stream-layer proxy_timeout in front of this server bounds *inactivity* on the
# whole TLS connection, and a session holds one open for the length of a match. The
# game heartbeats every ten seconds in both directions, so a 30-second stream
# timeout is not reached by a live session; anything under that interval ends
# matches for a reason no log on this host will name.

# Exact locations, because /healthz, /readyz and every other allocator path stay
# on the node: a /vif/ prefix would publish whatever is added there later.
